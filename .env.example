# Clothes Recommend System
DEFAULT_LOCATION=Seoul
LOCAL_MCP_COMMAND=python
LOCAL_MCP_ARGS=servers/local_stdio/server.py
REMOTE_MCP_URL=http://localhost:8000/mcp
REMOTE_MCP_AUTH_TOKEN=

# RAG Retriever Comparison (rag_compare)
# embedding_backend: hash | openai | sentence_transformers
EMBEDDING_BACKEND=hash
# llm_backend: heuristic | openai
LLM_BACKEND=heuristic
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
DEFAULT_VECTOR_BACKEND=faiss
CORPUS_DIR=data/corpus
INDEX_DIR=data/indexes
EVAL_DIR=data/eval
TOP_K=5
API_HOST=127.0.0.1
API_PORT=8090
GRADIO_PORT=7860
LOG_LEVEL=INFO
