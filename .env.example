# Clothes Recommend System — runtime configuration
DEFAULT_LOCATION=Seoul

# Local MCP runtime (STDIO)
LOCAL_MCP_COMMAND=python
LOCAL_MCP_ARGS=servers/local_stdio/server.py

# Remote MCP client — set to ALB/API Gateway/APIM URL in cloud environments
REMOTE_MCP_URL=http://localhost:8000/mcp
REMOTE_MCP_AUTH_TOKEN=
REMOTE_MCP_API_KEY=

# Remote MCP server bind (use 0.0.0.0 behind containers / load balancers)
REMOTE_MCP_HOST=0.0.0.0
REMOTE_MCP_PORT=8000
REMOTE_MCP_PATH=/mcp
# Stateless mode enables safe horizontal scaling (no sticky sessions required)
REMOTE_MCP_STATELESS_HTTP=true
REMOTE_MCP_LOG_LEVEL=INFO
# Optional Host / CORS allow-lists (comma-separated)
REMOTE_MCP_ALLOWED_HOSTS=
REMOTE_MCP_ALLOWED_ORIGINS=
